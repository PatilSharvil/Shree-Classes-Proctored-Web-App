# Local development (backend on the same machine)
VITE_API_URL=http://localhost:5000/api

# Academy live setup (Vercel): the frontend auto-discovers the backend's
# Cloudflare tunnel URL from Supabase. These two are REQUIRED on Vercel —
# without them the app silently falls back to localhost and nothing connects.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: pin a fixed backend (e.g. a permanent custom domain). Leave unset
# on Vercel to use auto-discovery. Never set this to localhost on Vercel.
# VITE_API_URL=https://api.yourdomain.com/api
